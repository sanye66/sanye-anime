# sanye_anime 作品导入脚本本地配置模板。
# 使用时复制为 import-anime.env，并放在本文件同一目录。
# 正式环境不要把真实密码提交到仓库。

SANYE_ADMIN_URL=http://localhost:8091/api/v1/admin
SANYE_ADMIN_USERNAME=admin
SANYE_ADMIN_PASSWORD=

# 可选：提前写好一个或多个 URL，多个地址用逗号分隔。
SANYE_IMPORT_URLS=

# true 表示导入后直接发布；false 表示只创建或更新草稿。
SANYE_IMPORT_PUBLISH=false

# true 表示只预览解析结果，不登录、不上传、不写库。
SANYE_IMPORT_DRY_RUN=false

# true 表示跳过封面下载和上传。
SANYE_IMPORT_SKIP_COVER=false

# true 表示批量导入时单条失败继续处理后续条目。
SANYE_IMPORT_CONTINUE_ON_ERROR=true

# 额外授权来源或封面 CDN 域名，多个用逗号分隔。
SANYE_IMPORT_ALLOW_HOSTS=
